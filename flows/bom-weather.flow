        "z": "c9f1a2b3d4e5f6g7",
        "command": "curl",
        "addpay": "payload",
        "append": "-s ftp://ftp.bom.gov.au/anon/gen/fwo/IDS60920.xml",
        "useSpawn": "false",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "Get BOM Weather Data",
        "x": 510,
        "y": 80,
