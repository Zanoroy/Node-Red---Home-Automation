    {
        "id": "fetch_weather",
        "type": "function",
        "z": "google_weather_tab",
        "name": "Get Weather from Global",
        "func": "// Get BOM observations (current conditions)\nconst weatherData = global.get('weather_data') || {\n    temperature: null,\n    apparent_temperature: null,\n    min_temperature: null,\n    max_temperature: null,\n    humidity: null,\n    wind_speed: null,\n    wind_direction: '',\n    cloud_description: ''\n};\n\n// Get Google Weather forecast data for today\nconst forecastData = global.get('weather_forecast_today') || {};\n\n// Merge forecast data with observations\n// Use forecast min/max if available (they're more accurate predictions)\nif (forecastData.min_temp !== null && forecastData.min_temp !== undefined) {\n    weatherData.min_temperature = forecastData.min_temp;\n}\nif (forecastData.max_temp !== null && forecastData.max_temp !== undefined) {\n    weatherData.max_temperature = forecastData.max_temp;\n}\n\n// Add rainfall/precipitation data\nif (forecastData.precipitation_prob_day !== null && forecastData.precipitation_prob_day !== undefined) {\n    weatherData.precipitation_prob_day = forecastData.precipitation_prob_day;\n}\nif (forecastData.precipitation_amount_day !== null && forecastData.precipitation_amount_day !== undefined) {\n    weatherData.precipitation_amount_day = forecastData.precipitation_amount_day;\n}\n\n// Use forecast day condition and icon\nif (forecastData.day_condition && forecastData.day_condition !== 'null') {\n    weatherData.day_condition = forecastData.day_condition;\n} else {\n    weatherData.day_condition = 'Loading...';\n}\n\nif (forecastData.weather_icon) {\n    weatherData.weather_icon = forecastData.weather_icon;\n}\n\n// Use forecast wind data if BOM doesn't have it or forecast has it\nif (forecastData.wind_direction_day !== null && forecastData.wind_direction_day !== undefined) {\n    weatherData.wind_direction_degrees = forecastData.wind_direction_day;\n}\n\nglobal.set('weather', weatherData);\n\nmsg.topic = 'weather';\nmsg.payload = weatherData;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\n// Get BOM observations (current conditions)\nconst weatherData = global.get('weather_data') || {\n    temperature: null,\n    apparent_temperature: null,\n    min_temperature: null,\n    max_temperature: null,\n    humidity: null,\n    wind_speed: null,\n    wind_direction: '',\n    cloud_description: ''\n};\n\n// Get Google Weather forecast data for today\nconst forecastData = global.get('weather_forecast_today') || {};\n\n// Merge forecast data with observations\n// Use forecast min/max if available (they're more accurate predictions)\nif (forecastData.min_temp !== null && forecastData.min_temp !== undefined) {\n    weatherData.min_temperature = forecastData.min_temp;\n}\nif (forecastData.max_temp !== null && forecastData.max_temp !== undefined) {\n    weatherData.max_temperature = forecastData.max_temp;\n}\n\n// Add rainfall/precipitation data\nif (forecastData.precipitation_prob_day !== null && forecastData.precipitation_prob_day !== undefined) {\n    weatherData.precipitation_prob_day = forecastData.precipitation_prob_day;\n}\nif (forecastData.precipitation_amount_day !== null && forecastData.precipitation_amount_day !== undefined) {\n    weatherData.precipitation_amount_day = forecastData.precipitation_amount_day;\n}\n\n// Use forecast day condition and icon\nif (forecastData.day_condition && forecastData.day_condition !== 'null') {\n    weatherData.day_condition = forecastData.day_condition;\n} else {\n    weatherData.day_condition = 'Loading...';\n}\n\nif (forecastData.weather_icon) {\n    weatherData.weather_icon = forecastData.weather_icon;\n}\n\n// Use forecast wind data if BOM doesn't have it or forecast has it\nif (forecastData.wind_direction_day !== null && forecastData.wind_direction_day !== undefined) {\n    weatherData.wind_direction_degrees = forecastData.wind_direction_day;\n}\n\n// msg.topic = 'weather';\n// msg.payload = weatherData;\n// return msg;",
        "finalize": "",
