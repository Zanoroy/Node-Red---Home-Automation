[
    {
        "id": "hubitat_device_inventory_tab",
        "type": "tab",
        "label": "Hubitat Device Inventory",
        "disabled": false,
        "info": "MakerAPI device normalization and category-specific formatting. TAG:Light, TAG:Mower, TAG:Switch, and TAG:3dPrinter markers in device notes take precedence over other classification heuristics (except the fixed mower IDs). If no recognized note marker is present, existing classification is used."
    },
    {
        "id": "device_inventory_in",
        "type": "link in",
        "z": "hubitat_device_inventory_tab",
        "name": "MakerAPI device inventory in",
        "links": [
            "device_inventory_link_out"
        ],
        "x": 160,
        "y": 180,
        "wires": [
            [
                "normalize_classify_devices"
            ]
        ]
    },
    {
        "id": "normalize_classify_devices",
        "type": "function",
        "z": "hubitat_device_inventory_tab",
        "name": "Normalize & Classify Devices",
        "func": "const input = msg.payload;\nif (!Array.isArray(input)) {\n    node.error('Hubitat MakerAPI response is not a device array.', msg);\n    return null;\n}\n\nconst mowerIds = [88, 89, 90, 91, 94, 95, 96, 97];\n\nfunction attrValue(device, name) {\n    const attrs = device && device.attributes;\n    if (Array.isArray(attrs)) {\n        const found = attrs.find((entry) => String(entry.name || '').toLowerCase() === name.toLowerCase());\n        return found ? found.currentValue : undefined;\n    }\n    if (attrs && typeof attrs === 'object') {\n        const key = Object.keys(attrs).find((candidate) => candidate.toLowerCase() === name.toLowerCase());\n        return key === undefined ? undefined : attrs[key];\n    }\n    return undefined;\n}\n\nfunction displayValue(value) {\n    if (value === undefined || value === null || value === '') return null;\n    if (typeof value === 'object') return value.name || value.label || null;\n    return String(value);\n}\n\nconst groups = { lights: [], switches: [], mowers: [], printers: [], ams: [], other: [] };\nconst inventory = input.map((device) => {\n    const name = displayValue(device.name) || displayValue(device.label) || `Device ${device.id}`;\n    const label = displayValue(device.label) || name;\n    const driver = displayValue(device.type) || displayValue(device.deviceType) || displayValue(device.driver) || '';\n    const metadata = [name, label, driver].join(' ').toLowerCase();\n    const attributes = device.attributes;\n    const attributeNames = Array.isArray(attributes)\n        ? attributes.map((entry) => String(entry.name || '').toLowerCase())\n        : (attributes && typeof attributes === 'object' ? Object.keys(attributes).map((key) => key.toLowerCase()) : []);\n    const capabilities = Array.isArray(device.capabilities)\n        ? device.capabilities.map((entry) => String(typeof entry === 'string' ? entry : entry && entry.name || '').toLowerCase())\n        : [];\n    const has = (pattern) => attributeNames.some((attribute) => pattern.test(attribute)) || capabilities.some((capability) => pattern.test(capability));\n    const hasSwitch = has(/(^|[^a-z])switch([^a-z]|$)/);\n    const hasColor = has(/color|hue|saturation|color.?temperature/);\n    const isRgbLight = /\\blight\\s*rgb\\b/.test(metadata) || has(/colorcontrol/) || has(/^(hue|saturation|rgb|color|colormode)$/);\n    const notes = displayValue(device.notes) || displayValue(attrValue(device, 'notes')) || '';\n    const notesTagMatch = notes.match(/(?:^|[\\s,;|])TAG\\s*:\\s*(Light|Mower|Switch|3d\\s*Printer)\\b/i);\n    const matchedNotesTag = notesTagMatch ? notesTagMatch[1].toLowerCase().replace(/\\s+/g, '') : null;\n    const notesTag = matchedNotesTag === '3dprinter' ? '3dPrinter' : matchedNotesTag ? matchedNotesTag.charAt(0).toUpperCase() + matchedNotesTag.slice(1) : null;\n    const rawTags = device.tags ?? device.tag;\n    const tagValues = Array.isArray(rawTags)\n        ? rawTags.map((tag) => typeof tag === 'string' ? tag : displayValue(tag)).filter(Boolean)\n        : (typeof rawTags === 'string' ? rawTags.split(/[;,|]/).map((tag) => tag.trim()).filter(Boolean) : []);\n    const explicitCategories = {\n        light: 'lights', lights: 'lights', lamp: 'lights', bulb: 'lights',\n        switch: 'switches', switches: 'switches',\n        mower: 'mowers', mowers: 'mowers',\n        printer: 'printers', printers: 'printers', '3dprinter': 'printers',\n        ams: 'ams',\n        other: 'other'\n    };\n    const taggedCategory = tagValues.map((tag) => {\n        const match = String(tag).match(/^(?:type|category)\\s*[:=]\\s*(.+)$/i);\n        return (match ? match[1] : tag).trim().toLowerCase();\n    }).find((tag) => Object.prototype.hasOwnProperty.call(explicitCategories, tag));\n    const declaredCategory = String(notesTag ?? attrValue(device, 'deviceCategory') ?? attrValue(device, 'deviceType') ?? taggedCategory ?? '').trim().toLowerCase();\n    const hasExplicitCategory = Object.prototype.hasOwnProperty.call(explicitCategories, declaredCategory);\n    const deviceId = Number(device.id);\n    let category = 'other';\n\n    if (mowerIds.includes(deviceId)) {\n        category = 'mowers';\n    } else if (hasExplicitCategory) {\n        category = explicitCategories[declaredCategory];\n    } else if (/\\bams\\b|automatic.?material/.test(metadata)) {\n        category = 'ams';\n    } else if (/printer|snapmaker|bambu|3d.?print/.test(metadata) || has(/printer|print.?state|hotend|nozzle|gcode/)) {\n        category = 'printers';\n    } else if (has(/filament|tray.?type/)) {\n        category = 'ams';\n    } else if (/light|bulb|lamp|dimmer|lighting/.test(metadata) || (hasSwitch && hasColor)) {\n        category = 'lights';\n    } else if (hasSwitch || /\\bswitch\\b/.test(metadata)) {\n        category = 'switches';\n    }\n\n    const room = displayValue(device.room) || displayValue(device.roomName) || displayValue(device.location) ||\n        displayValue(device.locationName) || displayValue(attrValue(device, 'room')) || displayValue(attrValue(device, 'location'));\n    const normalized = {\n        id: device.id,\n        name,\n        label,\n        location: room,\n        room,\n        tag: notesTag || rawTags || null,\n        notes: notes || null,\n        type: category === 'printers' ? 'printer' : category === 'mowers' ? 'mower' : category === 'lights' ? (isRgbLight ? 'light rgb' : 'light') : category === 'switches' ? 'switch' : category,\n        driver,\n        attributeNames,\n        capabilities\n    };\n    groups[category].push({ ...device, ...normalized });\n    return normalized;\n});\n\nmsg.deviceGroups = groups;\nmsg.devices = inventory;\nmsg.formatted = {};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 180,
