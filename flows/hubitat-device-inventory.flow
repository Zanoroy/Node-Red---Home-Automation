    {
        "id": "format_lights",
        "type": "function",
        "z": "hubitat_device_inventory_tab",
        "name": "Format Lights",
        "func": "function getAttr(device, key) {\n    const attrs = device.attributes;\n    if (Array.isArray(attrs)) {\n        const match = attrs.find((entry) => String(entry.name || '').toLowerCase() === key.toLowerCase());\n        return match ? match.currentValue : undefined;\n    }\n    if (attrs && typeof attrs === 'object') {\n        const found = Object.keys(attrs).find((name) => name.toLowerCase() === key.toLowerCase());\n        return found === undefined ? undefined : attrs[found];\n    }\n    return undefined;\n}\nmsg.formatted.lights = msg.deviceGroups.lights.map((device) => {\n    const switchState = String(getAttr(device, 'switch') || '').toLowerCase();\n    const deviceType = device.type === 'light rgb' ? 'light rgb' : 'light';\n    return {\n        id: device.id,\n        name: device.label || device.name,\n        label: device.label,\n        location: device.location,\n        room: device.room,\n        tag: device.tag,\n        state: switchState === 'on' ? 'on' : 'off',\n        type: deviceType,\n        deviceType,\n        driver: device.driver,\n        hue: getAttr(device, 'hue'),\n        saturation: getAttr(device, 'saturation'),\n        level: getAttr(device, 'level'),\n        color: getAttr(device, 'color'),\n        colorName: getAttr(device, 'colorName')\n    };\n});\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 260,
        "wires": [
            [
                "format_switches"
            ]
        ]
    },
    {
        "id": "format_switches",
        "type": "function",
        "z": "hubitat_device_inventory_tab",
        "name": "Format Switches",
        "func": "function getAttr(device, key) {\n    const attrs = device.attributes;\n    if (Array.isArray(attrs)) {\n        const match = attrs.find((entry) => String(entry.name || '').toLowerCase() === key.toLowerCase());\n        return match ? match.currentValue : undefined;\n    }\n    if (attrs && typeof attrs === 'object') {\n        const found = Object.keys(attrs).find((name) => name.toLowerCase() === key.toLowerCase());\n        return found === undefined ? undefined : attrs[found];\n    }\n    return undefined;\n}\nmsg.formatted.switches = msg.deviceGroups.switches.map((device) => ({\n    id: device.id,\n    name: device.label || device.name,\n    label: device.label,\n    location: device.location,\n    room: device.room,\n    tag: device.tag,\n    state: String(getAttr(device, 'switch') || 'unknown').toLowerCase(),\n    type: 'switch',\n    driver: device.driver\n}));\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 340,
        "wires": [
            [
                "format_mowers"
            ]
        ]
    },
    {
        "id": "format_mowers",
        "type": "function",
        "z": "hubitat_device_inventory_tab",
        "name": "Format Mowers",
        "func": "const mowerErrorDictionary = {\n    \"none\": { id: 0, label: \"System Normal\" },\n    \"no_error\": { id: 0, label: \"System Normal\" },\n    \"outside_wire\": { id: 1, label: \"Outside Wire Boundary\" },\n    \"wheel_motor_fault\": { id: 2, label: \"Wheel Motor Fault\" },\n    \"blade_motor_fault\": { id: 3, label: \"Blade Motor Fault\" },\n    \"trapped\": { id: 4, label: \"Mower Trapped\" },\n    \"lifted\": { id: 5, label: \"Mower Lifted\" },\n    \"upside_down\": { id: 6, label: \"Mower Upside Down\" },\n    \"battery_charging_error\": { id: 7, label: \"Battery Charging Error\" },\n    \"cannot_find_charging_base\": { id: 8, label: \"Base Missing / Dock Blocked\" },\n    \"lock_timeout\": { id: 9, label: \"Anti-Theft Lock Active\" },\n    \"unauthorized_zone\": { id: 10, label: \"Safety / Perimeter Lock\" },\n    \"battery_temperature_error\": { id: 11, label: \"Battery Temperature Fault\" },\n    \"camera_dirty\": { id: 12, label: \"Camera Vision Blocked\" },\n    \"vision_fault\": { id: 13, label: \"Vision Sensor Fault\" },\n    \"wire_missing\": { id: 14, label: \"Boundary Wire Missing / Cut\" },\n    \"rain_delay\": { id: 99, label: \"Rain Delay\" }\n};\n\nfunction getAttr(device, key) {\n    if (!device || !device.attributes) return undefined;\n\n    if (Array.isArray(device.attributes)) {\n        const match = device.attributes.find((attr) => String(attr.name || '').toLowerCase() === String(key).toLowerCase());\n        return match ? match.currentValue : undefined;\n    }\n\n    if (typeof device.attributes === 'object') {\n        if (Object.prototype.hasOwnProperty.call(device.attributes, key)) {\n            return device.attributes[key];\n        }\n\n        const foundKey = Object.keys(device.attributes).find((attrKey) => attrKey.toLowerCase() === String(key).toLowerCase());\n        if (foundKey) return device.attributes[foundKey];\n    }\n\n    return undefined;\n}\n\nconst mowerDevices = msg.deviceGroups.mowers;\nconst mowerData = {\n    bottom: { state: 'unknown', battery: '--', charging: 'off', error: { id: 0, info: 'no_error' }, updated: '--' },\n    top: { state: 'unknown', battery: '--', charging: 'off', error: { id: 0, info: 'no_error' }, updated: '--' }\n};\nconst dateStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });\n\nmowerDevices.forEach((device) => {\n    if (!device.attributes) return;\n\n    let rawText = '';\n    let lookupKey = '';\n    const currentId = parseInt(device.id, 10);\n\n    switch (currentId) {\n        case 88: // Bottom state\n            mowerData.bottom.state = String(getAttr(device, 'lawnMower') || 'unknown').toLowerCase();\n            mowerData.bottom.updated = dateStr;\n            break;\n        case 90: // Bottom battery\n            mowerData.bottom.battery = getAttr(device, 'battery') || '--';\n            mowerData.bottom.updated = dateStr;\n            break;\n        case 91: // Bottom charging\n            mowerData.bottom.charging = String(getAttr(device, 'value') || 'off').toLowerCase();\n            mowerData.bottom.updated = dateStr;\n            break;\n        case 89: // Bottom error\n            rawText = String(getAttr(device, 'value') || 'no_error').toLowerCase();\n            lookupKey = rawText.trim().toLowerCase().replace(/[\\s-]/g, '_');\n            mowerData.bottom.error = mowerErrorDictionary[lookupKey] || { id: -1, label: `Unknown Error Code (${rawText})` };\n            mowerData.bottom.updated = dateStr;\n            break;\n\n        case 95: // Top state\n            mowerData.top.state = String(getAttr(device, 'lawnMower') || 'unknown').toLowerCase();\n            mowerData.top.updated = dateStr;\n            break;\n        case 94: // Top battery\n            mowerData.top.battery = getAttr(device, 'battery') || '--';\n            mowerData.top.updated = dateStr;\n            break;\n        case 97: // Top charging\n            mowerData.top.charging = String(getAttr(device, 'value') || 'off').toLowerCase();\n            mowerData.top.updated = dateStr;\n            break;\n        case 96: // Top error\n            rawText = String(getAttr(device, 'value') || 'no_error').toLowerCase();\n            lookupKey = rawText.trim().toLowerCase().replace(/[\\s-]/g, '_');\n            mowerData.top.error = mowerErrorDictionary[lookupKey] || { id: -1, label: `Unknown Error Code (${rawText})` };\n            mowerData.top.updated = dateStr;\n            break;\n        default:\n            break;\n    }\n});\n\nmsg.formatted.mowers = mowerData;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 420,
