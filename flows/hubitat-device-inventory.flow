        "func": "const summary = {\n    lights: msg.formatted.lights,\n    switches: msg.formatted.switches,\n    mowers: msg.formatted.mowers,\n    printers: msg.formatted.printers,\n    devices: msg.devices,\n    weather: global.get('weather'),\n    ams: msg.formatted.ams\n};\nglobal.set('hubitat_devices', summary);\nmsg.topic = 'hubitat_devices';\nmsg.payload = summary;\nreturn msg;",
