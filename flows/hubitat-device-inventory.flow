    {
        "id": "format_printers",
        "type": "function",
        "z": "hubitat_device_inventory_tab",
        "name": "Format Printers & AMS",
        "func": "const printerDevices = msg.deviceGroups.printers;\nconst amsDevice = msg.deviceGroups.ams[0] || null;\n\nfunction getAttr(device, key) {\n    if (!device || !device.attributes) return undefined;\n\n    if (Array.isArray(device.attributes)) {\n        const match = device.attributes.find((attr) => String(attr.name || '').toLowerCase() === String(key).toLowerCase());\n        return match ? match.currentValue : undefined;\n    }\n\n    if (typeof device.attributes === 'object') {\n        if (Object.prototype.hasOwnProperty.call(device.attributes, key)) {\n            return device.attributes[key];\n        }\n\n        const foundKey = Object.keys(device.attributes).find((attrKey) => attrKey.toLowerCase() === String(key).toLowerCase());\n        if (foundKey) return device.attributes[foundKey];\n    }\n\n    return undefined;\n}\n\nfunction parseTimeTextToSec(value) {\n    if (value === null || value === undefined) return null;\n    const text = String(value).trim();\n    if (!text || text === '\u2014' || text.toLowerCase() === 'none') return null;\n\n    const sanitized = text.replace(/\\s+/g, '').replace(/\\((.*)\\)/g, '');\n    const parts = sanitized.split(':').map((p) => Number(p));\n    if (parts.some((part) => Number.isNaN(part))) return null;\n\n    if (parts.length === 3) return (parts[0] * 3600) + (parts[1] * 60) + parts[2];\n    if (parts.length === 2) return (parts[0] * 60) + parts[1];\n    if (parts.length === 1) return parts[0];\n    return null;\n}\n\nfunction parseDurationMinutesValue(value) {\n    if (value === null || value === undefined || value === '') return null;\n    if (typeof value === 'number' && Number.isFinite(value)) return value;\n    const numeric = Number(value);\n    if (Number.isFinite(numeric)) return numeric;\n    return value * 60;\n}\n\nfunction parseDurationValue(value) {\n    if (value === null || value === undefined || value === '') return null;\n    if (typeof value === 'number' && Number.isFinite(value)) return value;\n    const numeric = Number(value);\n    if (Number.isFinite(numeric)) return numeric;\n    return parseTimeTextToSec(value);\n}\n\nfunction asNumber(value) {\n    if (value === null || value === undefined || value === '') return null;\n    const number = Number(String(value).replace(/[^0-9.-]/g, ''));\n    return Number.isFinite(number) ? number : null;\n}\n\nfunction normalizeFilename(value) {\n    const text = String(value || '').trim();\n    if (!text || text.toLowerCase() === 'none' || text === '\u2014') return '';\n    return text;\n}\n\nfunction getCommandsList(device) {\n    if (!device || !Array.isArray(device.commands)) return [];\n    return device.commands.map((cmd) => {\n        if (typeof cmd === 'string') return cmd;\n        if (cmd && typeof cmd.command === 'string') return cmd.command;\n        return '';\n    }).filter(Boolean);\n}\n\nfunction getAttributeValue(device, candidates) {\n    if (!device || !device.attributes) return undefined;\n    const names = Array.isArray(candidates) ? candidates : [candidates];\n    for (const candidate of names) {\n        const value = getAttr(device, candidate);\n        if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n    }\n    return undefined;\n}\n\nfunction parseJsonObject(value) {\n    if (!value) return {};\n    if (typeof value === 'object') return value;\n    if (typeof value !== 'string') return {};\n\n    try {\n        const parsed = JSON.parse(value);\n        return parsed && typeof parsed === 'object' ? parsed : {};\n    } catch (err) {\n        return {};\n    }\n}\n\nfunction normalizePrinterState(rawState, isConnected) {\n    if (!isConnected) return 'OFFLINE';\n\n    const key = String(rawState || '').trim().toUpperCase();\n    const stateMap = {\n        'STANDBY':   'IDLE',\n        'IDLE':      'IDLE',\n        'READY':     'IDLE',\n        'STARTUP':   'PREPARING',\n        'PREPARE':   'PREPARING',\n        'SLICING':   'PREPARING',\n        'PRINTING':  'PRINTING',\n        'RUNNING':   'PRINTING',\n        'PAUSED':    'PAUSED',\n        'PAUSE':     'PAUSED',\n        'COMPLETE':  'COMPLETE',\n        'COMPLETED': 'COMPLETE',\n        'FINISH':    'COMPLETE',\n        'FINISHED':  'COMPLETE',\n        'CANCELLED': 'CANCELLED',\n        'CANCELED':  'CANCELLED',\n        'STOPPED':   'CANCELLED',\n        'ERROR':     'ERROR',\n        'FAILED':    'ERROR',\n        'SHUTDOWN':  'ERROR',\n        'OFFLINE':   'OFFLINE'\n    };\n\n    return stateMap[key] || key || 'UNKNOWN';\n}\n\nfunction normalizeTrayColor(value) {\n    const raw = String(value || '').trim();\n    if (!raw) return '';\n    const cleaned = raw.replace(/^#/, '');\n    if (!/^[0-9a-fA-F]+$/.test(cleaned)) return raw;\n    if (cleaned.length >= 6) return '#' + cleaned.slice(0, 6);\n    return '#' + cleaned;\n}\n\nconst bambuddyStatus = global.get('bambuddy_status') || null;\nconst bambuddyAms = (bambuddyStatus && Array.isArray(bambuddyStatus.ams) && bambuddyStatus.ams.length)\n    ? bambuddyStatus.ams[0]\n    : null;\nconst bambuddyActiveTray = (bambuddyAms && Array.isArray(bambuddyAms.tray))\n    ? bambuddyAms.tray.find((tray) => tray && tray.exists && String(tray.tray_type || '').trim()) || bambuddyAms.tray[0]\n    : null;\n\nconst amsFromBambuddy = bambuddyAms ? {\n    id: bambuddyAms.id ?? null,\n    name: normalizeFilename(bambuddyAms.module_type || 'Bambu Lab AMS'),\n    connected: true,\n    temperature: asNumber(bambuddyAms.temp),\n    humidity: asNumber(bambuddyAms.humidity),\n    moduleType: normalizeFilename(bambuddyAms.module_type || bambuddyAms.moduleType || 'ams'),\n    filamentLoaded: bambuddyActiveTray ? 'true' : 'false',\n    filamentType: normalizeFilename(bambuddyActiveTray ? bambuddyActiveTray.tray_type : ''),\n    filamentColor: normalizeFilename(normalizeTrayColor(bambuddyActiveTray ? bambuddyActiveTray.tray_color : ''))\n} : null;\n\nconst amsFromHubitat = amsDevice ? {\n    id: parseInt(amsDevice.id, 10),\n    name: amsDevice.label || amsDevice.name || 'AMS',\n    connected: String(getAttr(amsDevice, 'connected') || 'true').toLowerCase() !== 'false',\n    temperature: asNumber(getAttr(amsDevice, 'temperature')),\n    humidity: asNumber(getAttr(amsDevice, 'humidity')),\n    moduleType: normalizeFilename(getAttr(amsDevice, 'moduleType')),\n    filamentLoaded: getAttr(amsDevice, 'filamentLoaded'),\n    filamentType: normalizeFilename(getAttr(amsDevice, 'loadedFilamentType') || getAttr(amsDevice, 'filamentType')),\n    filamentColor: normalizeFilename(getAttr(amsDevice, 'loadedFilamentColor') || getAttr(amsDevice, 'filamentColor'))\n} : null;\n\nconst amsSummary = amsFromBambuddy || amsFromHubitat;\n\nconst formattedPrinters = printerDevices.map((device) => {\n    const printerId = Number.isFinite(Number(device.id)) ? Number(device.id) : device.id;\n    const isBambuPrinter = /bambu|p1s|x1c|a1/i.test(`${device.label || ''} ${device.name || ''} ${device.type || ''} ${device.driver || ''}`);\n    const commands = getCommandsList(device);\n    const driverName = String(device.driver || device.type || 'Printer');\n    const printerHealthValue =\n        getAttr(device, 'healthStatus') ??\n        getAttr(device, 'connected') ??\n        'unknown';\n\n    const stateVal =\n        getAttr(device, 'state') ??\n        getAttr(device, 'printerStatus') ??\n        getAttr(device, 'printState') ??\n        getAttr(device, 'status') ??\n        'unknown';\n\n    let rawState = String(stateVal !== null && stateVal !== undefined && String(stateVal).trim() ? stateVal : 'unknown').trim();\n    let healthStatusValue = String(printerHealthValue !== null && printerHealthValue !== undefined && String(printerHealthValue).trim() ? printerHealthValue : 'Unknown').trim();\n    healthStatusValue = healthStatusValue.toLowerCase() == 'true' || healthStatusValue.toLowerCase() == 'online' ? \"Online\" : \"Offline\";\n    let errorText = String(\n        getAttr(device, 'hmsError') ??\n        getAttr(device, 'error') ??\n        getAttr(device, 'printerError') ??\n        ''\n    ).trim();\n\n    let filename =\n        normalizeFilename(getAttr(device, 'currentPrint')) ||\n        normalizeFilename(getAttr(device, 'filename')) ||\n        normalizeFilename(getAttr(device, 'currentFile')) ||\n        normalizeFilename(getAttr(device, 'lastPrint'));\n\n    let nozzle = asNumber(getAttr(device, 'lastHotendVal')) ?? asNumber(getAttr(device, 'nozzleTemp')) ?? asNumber(getAttr(device, 'nozzleTemperature')) ?? asNumber(getAttr(device, 'hotendTemp')) ?? asNumber(getAttr(device, 'temperature'));\n    let bed = asNumber(getAttr(device, 'bedTemp')) ?? asNumber(getAttr(device, 'bedTemperature')) ?? asNumber(getAttr(device, 'bedTempC'));\n    let nozzleTarget = asNumber(getAttr(device, 'hotendTargTemp')) ?? 0;\n    let bedTarget = asNumber(getAttr(device, 'bedTargTemp')) ?? asNumber(getAttr(device, 'bedTargetC')) ?? 0;\n\n    let chamber = asNumber(getAttr(device, 'chamberTemp')) ?? asNumber(getAttr(device, 'chamberTemperature'));\n    let elapsedSec = parseDurationValue(getAttr(device, 'elapsedTime')) ?? parseDurationValue(getAttr(device, 'printElapsed')) ?? parseDurationValue(getAttr(device, 'printElapsedTime'));\n    let remainingSec = parseDurationMinutesValue(getAttr(device, 'remainingTime')) ?? parseDurationValue(getAttr(device, 'printRemaining')) ?? parseDurationValue(getAttr(device, 'timeRemaining'));\n    let progress = asNumber(getAttr(device, 'progress')) ?? asNumber(getAttr(device, 'printProgress'));\n    let connected = healthStatusValue === 'Online' && String(getAttr(device, 'connected') || 'true').toLowerCase() !== 'false';\n    let bambuddyMeta = null;\n\n    if (isBambuPrinter && bambuddyStatus && typeof bambuddyStatus === 'object') {\n        rawState = String(bambuddyStatus.state || rawState || 'unknown');\n        filename = normalizeFilename(bambuddyStatus.current_print || bambuddyStatus.subtask_name || bambuddyStatus.gcode_file || filename);\n\n        const tempBlock = bambuddyStatus.temperatures || {};\n        nozzle = asNumber(tempBlock.nozzle) ?? nozzle;\n        bed = asNumber(tempBlock.bed) ?? bed;\n        chamber = asNumber(tempBlock.chamber) ?? chamber;\n        const remaining_time = bambuddyStatus.remaining_time ?? 0\n        remainingSec = remaining_time > 0 ? bambuddyStatus.remaining_time * 60 : remainingSec;\n        progress = asNumber(bambuddyStatus.progress) ?? progress;\n        connected = bambuddyStatus.connected !== false;\n\n        if (Array.isArray(bambuddyStatus.hms_errors) && bambuddyStatus.hms_errors.length) {\n            errorText = bambuddyStatus.hms_errors.map((item) => {\n                if (typeof item === 'string') return item;\n                if (item && typeof item === 'object') return item.message || item.code || JSON.stringify(item);\n                return '';\n            }).filter(Boolean).join(' | ');\n        }\n\n        const activeAms = (Array.isArray(bambuddyStatus.ams) && bambuddyStatus.ams.length) ? bambuddyStatus.ams[0] : null;\n        const slots = (activeAms && Array.isArray(activeAms.tray))\n            ? activeAms.tray\n                .filter((slot) => slot)\n                .map((slot, index) => ({\n                    id: slot.id ?? index,\n                    index: index + 1,\n                    type: normalizeFilename(slot.tray_type),\n                    color: normalizeTrayColor(slot.tray_color),\n                    remain: asNumber(slot.remain),\n                    kFactor: asNumber(slot.k)\n                }))\n            : [];\n\n        bambuddyMeta = {\n            connected: bambuddyStatus.connected !== false,\n            wifiSignal: asNumber(bambuddyStatus.wifi_signal),\n            firmware: normalizeFilename(bambuddyStatus.firmware_version),\n            model: normalizeFilename(bambuddyStatus.model || bambuddyStatus.printer_model || 'P1S'),\n            nozzleDiameter: normalizeFilename(\n                Array.isArray(bambuddyStatus.nozzles) && bambuddyStatus.nozzles[0]\n                    ? bambuddyStatus.nozzles[0].nozzle_diameter\n                    : ''\n            ),\n            progressPercent: asNumber(bambuddyStatus.progress),\n            amsHumidity: activeAms ? asNumber(activeAms.humidity) : null,\n            amsTemperature: activeAms ? asNumber(activeAms.temp) : null,\n            amsName: activeAms ? normalizeFilename(activeAms.module_type || 'AMS-A').toUpperCase() : 'AMS-A',\n            amsSlots: slots\n        };\n    }\n\n    const state = normalizePrinterState(rawState, connected);\n    const normalizedError = (!errorText || /^(none|normal|no error|idle|\u2014)$/i.test(errorText)) ? '' : errorText;\n\n    const idle = ['IDLE', 'COMPLETE', 'CANCELLED', 'OFFLINE'].includes(state);\n    const isPrinting = ['PRINTING', 'PREPARING'].includes(state);\n\n    const commandMap = {};\n    if (commands.includes('pausePrint')) commandMap.pause = 'pausePrint';\n    if (commands.includes('resumePrint')) commandMap.resume = 'resumePrint';\n    if (commands.includes('pause')) commandMap.pause = 'pause';\n    if (commands.includes('resume')) commandMap.resume = 'resume';\n    if (commands.includes('cancel')) commandMap.stop = 'cancel';\n    if (commands.includes('stopPrint')) commandMap.stop = 'stopPrint';\n    if (commands.includes('startLastPrint')) commandMap.lastJob = 'startLastPrint';\n    if (commands.includes('startPrint')) commandMap.lastJob = 'startPrint';\n\n    const isSnapmaker = /snapmaker/i.test(`${device.label || ''} ${device.name || ''} ${device.type || ''} ${device.driver || ''}`);\n    const snapmakerHeads = isSnapmaker ? [1, 2, 3, 4].map((idx) => {\n        const temp = asNumber(getAttributeValue(device, [\n            `head${idx}TempC`,\n            `head${idx}Temp (\u00b0C)`,\n            `head${idx}Temp (\u00b0 C)`,\n            `head${idx}Temp`\n        ]));\n        const target = asNumber(getAttributeValue(device, [\n            `head${idx}TargetC`,\n            `head${idx}Target (\u00b0C)`,\n            `head${idx}Target (\u00b0 C)`,\n            `head${idx}Target`\n        ]));\n        return {\n            index: idx,\n            name: `head${idx}`,\n            temp: temp !== null ? temp : null,\n            target: target !== null ? target : null,\n            tempC: temp !== null ? temp : null,\n            targetC: target !== null ? target : null\n        };\n    }) : [];\n    if (isSnapmaker) {\n        nozzle = asNumber(getAttributeValue(device, 'activehotend')) ?? 0;\n        elapsedSec = (asNumber(getAttributeValue(device, 'elapsed')) ?? 0) * 60;\n        remainingSec = (asNumber(getAttributeValue(device, 'remaining')) ?? 0) * 60;\n        progress = asNumber(getAttributeValue(device, 'progress')) ?? 0;\n    }\n    const snapmakerStatusTile = isSnapmaker ? getAttributeValue(device, `aaStatusTile`) : ``;\n    const snapmakerFilaments = isSnapmaker ? [1, 2, 3, 4].map((idx) => {\n        const color = normalizeFilename(getAttributeValue(device, [`filament${idx}Color`])) || '';\n        const details = parseJsonObject(getAttributeValue(device, [`filament${idx}Details`]));\n        return {\n            index: idx,\n            color,\n            details: Object.keys(details).length ? details : null,\n            type: details && details.type ? normalizeFilename(details.type) : '',\n            vendor: details && details.vendor ? normalizeFilename(details.vendor) : '',\n            exists: !!(details && details.exists !== undefined ? details.exists : true),\n            physicalSlot: details && details.slot ? normalizeFilename(details.slot) : `slot${idx}`\n        };\n    }) : [];\n\n    return {\n        id: printerId,\n        name: device.label || device.name || ('Printer ' + printerId),\n        label: device.label || device.name || ('Printer ' + printerId),\n        location: device.location || null,\n        room: device.room || null,\n        tag: device.tag || null,\n        deviceType: 'printer',\n        driver: driverName,\n        state,\n        stateSource: ['state', 'printerStatus', 'printState'].find((candidate) => getAttr(device, candidate) !== undefined) || 'unknown',\n        isIdle: idle,\n        isPrinting: isPrinting,\n        error: normalizedError,\n        healthstatus: healthStatusValue,\n        filename,\n        temperatures: {\n            nozzle,\n            bed,\n            chamber\n        },\n        targettemperatures: {\n            nozzleTarget,\n            bedTarget\n        },\n        progress: {\n            elapsedSec,\n            remainingSec,\n            percent: progress\n        },\n        commands: commandMap,\n        extruders: isSnapmaker ? snapmakerHeads : [{ index: 1, temp: nozzle, target: nozzleTarget }],\n        filaments: isSnapmaker ? snapmakerFilaments : [],\n        snapmaker: isSnapmaker ? {\n            heads: snapmakerHeads,\n            filaments: snapmakerFilaments,\n            statustile: snapmakerStatusTile\n        } : null,\n        ams: isBambuPrinter ? amsSummary : null,\n        bambuddy: isBambuPrinter ? bambuddyMeta : null,\n        connected\n    };\n});\n\nmsg.formatted.printers = formattedPrinters;\nmsg.formatted.ams = amsSummary;\nreturn msg;",
        "outputs": 1,
