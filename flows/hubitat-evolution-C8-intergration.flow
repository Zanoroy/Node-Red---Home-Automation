    {
        "id": "a41ecdf812da6ba8",
        "type": "function",
        "z": "4a8f9e79502edb05",
        "name": "Database Perperation - Node-RED",
        "func": "// Ensure we received a valid array from the Maker API\nif (!Array.isArray(msg.payload)) {\n    node.error(\"Emporia Pull Error: Received payload is not a valid JSON array.\");\n    return null;\n}\n\nlet databasePoints = [];\n\n// Loop through every device returned by the Maker API pull\nmsg.payload.forEach(device => {\n    if (device.attributes && device.attributes.power !== undefined && device.attributes.power !== null) {\n        \n        // Grab the human-friendly circuit label\n        const deviceName = device.label || device.name || \"Circuit_\" + device.id;\n        \n        // Parse the raw power string safely into a signed integer (-1641, 406, 0)\n        const watts = parseInt(device.attributes.power, 10);\n        \n        if (isNaN(watts)) return;\n\n        const wattsText = watts.toString();\n\n        // Exact official schema structure for the Node-RED InfluxDB Batch node\n        databasePoints.push({\n            measurement: \"home_power\",\n            fields: {\n                value: watts,       // Integer metric data type\n                valueStr: wattsText // Text metric data type\n            },\n            tags: {\n                device: deviceName  // Indexes your 16 individual clamps cleanly\n            }\n        });\n    }\n});\n\n// If we populated circuits, pass the array straight to the Batch node\nif (databasePoints.length > 0) {\n    msg.payload = databasePoints;\n    return msg;\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 320,
        "wires": [
            [
                "7e60b3adc0a80664",
                "8b0b81da663b0752"
            ]
        ]
    },
