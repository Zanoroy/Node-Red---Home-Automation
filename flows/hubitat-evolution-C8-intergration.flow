    {
        "id": "handle_control",
        "type": "function",
        "z": "4a8f9e79502edb05",
        "name": "Handle Light Control",
        "func": "// Extract control payload\nconst control = msg.payload;\n\nconst baseUrl = 'http://172.17.98.214/apps/api/93/devices';\nconst accessToken = 'c978917f-7089-4041-937f-414a0bb2ab6d';\n\nif (!control || !control.type || !control.deviceId || !control.command) {\n    return null;\n}\n\nif (control.type === 'light' || control.type === 'mower' || control.type === 'printer') {\n    msg.url = `${baseUrl}/${control.deviceId}/${control.command}?access_token=${accessToken}`;\n    msg.method = 'GET';\n    msg.deviceId = control.deviceId;\n    msg.command = control.command;\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
