    {
        "id": "handle_control",
        "type": "function",
        "z": "4a8f9e79502edb05",
        "name": "Handle Light Control",
        "func": "// Extract control payload\nconst control = msg.payload;\n\nconst baseUrl = 'http://172.17.98.214/apps/api/93/devices';\nconst accessToken = 'c978917f-7089-4041-937f-414a0bb2ab6d';\n\nif (!control || !control.type || !control.deviceId || !control.command) {\n    return null;\n}\n\nif (control.type === 'light' || control.type === 'mower' || control.type === 'printer') {\n    let commandArgument = '';\n    if (control.command === 'setColor') {\n        const color = control.argument;\n        const hue = Number(color && color.hue);\n        const saturation = Number(color && color.saturation);\n        const hasLevel = color && color.level !== undefined && color.level !== null;\n        const level = hasLevel ? Number(color.level) : null;\n        if (control.type !== 'light' || !color || typeof color !== 'object' || Array.isArray(color) ||\n            !Number.isFinite(hue) || hue < 0 || hue > 100 ||\n            !Number.isFinite(saturation) || saturation < 0 || saturation > 100 ||\n            (hasLevel && (!Number.isFinite(level) || level < 0 || level > 100))) {\n            node.error('Invalid setColor command: expected a light with hue and saturation from 0 to 100, and an optional level from 0 to 100.', msg);\n            return null;\n        }\n        const colorMap = { hue: Math.round(hue), saturation: Math.round(saturation) };\n        if (hasLevel) colorMap.level = Math.round(level);\n        commandArgument = `/${encodeURIComponent(JSON.stringify(colorMap))}`;\n    } else if (control.command === 'setHue' || control.command === 'setSaturation') {\n        const value = Number(control.argument);\n        if (control.type !== 'light' || !Number.isFinite(value) || value < 0 || value > 100) {\n            node.error('Invalid color command: expected a light and a hue or saturation value from 0 to 100.', msg);\n            return null;\n        }\n        commandArgument = `/${Math.round(value)}`;\n    }\n\n    const deviceUrl = `${baseUrl}/${encodeURIComponent(String(control.deviceId))}/${encodeURIComponent(String(control.command))}${commandArgument}`;\n    if (control.command === 'setColor') {\n        msg.url = deviceUrl;\n        msg.method = 'POST';\n        const headers = msg.headers && typeof msg.headers === 'object' ? msg.headers : {};\n        msg.headers = Object.assign({}, headers, { Authorization: `Bearer ${accessToken}` });\n        msg.payload = '';\n    } else {\n        msg.url = `${deviceUrl}?access_token=${accessToken}`;\n        msg.method = 'GET';\n    }\n    msg.deviceId = control.deviceId;\n    msg.command = control.command;\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 200,
        "wires": [
            [
                "send_to_hubitat"
            ]
        ]
    },
