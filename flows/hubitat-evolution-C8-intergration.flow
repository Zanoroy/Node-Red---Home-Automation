    {
        "id": "7e60b3adc0a80664",
        "type": "influxdb batch",
        "z": "4a8f9e79502edb05",
        "influxdb": "230d7539dd8d1424",
        "precision": "",
        "retentionPolicy": "",
        "name": "",
        "database": "database",
        "precisionV18FluxV20": "ms",
