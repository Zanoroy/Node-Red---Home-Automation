    {
        "id": "handle_ui_output",
        "type": "switch",
        "z": "4a8f9e79502edb05",
        "name": "Route UI Commands",
        "property": "topic",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "control",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "dashboard",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 2,
        "x": 480,
        "y": 220,
