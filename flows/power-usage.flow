    {
        "id": "e912539061ab298f",
        "type": "function",
        "z": "67860df720f06663",
        "name": "Return InfluxDB error",
        "func": "const error = msg.error && typeof msg.error === 'object' ? msg.error : {};\nconst code = String(error.code || '').slice(0, 40);\nconst detail = String(error.message || 'Unknown InfluxDB node error.')\n  .replace(/(token\\s+)[^\\s,;]+/gi, '$1[redacted]')\n  .replace(/(authorization:\\s*)[^\\s,;]+/gi, '$1[redacted]')\n  .slice(0, 240);\nnode.warn(`InfluxDB power query failed${code ? ` (${code})` : ''}: ${detail}`);\nmsg.statusCode = 502;\nmsg.headers = { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' };\nmsg.payload = { error: 'Unable to query InfluxDB for power data. Check the Node-RED log for details.' };\nreturn msg;",
