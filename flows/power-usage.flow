    {
        "id": "d896472bafe5d23c",
        "type": "function",
        "z": "67860df720f06663",
        "name": "Authorize and build Flux query",
        "func": "function respondError(statusCode, message) {\n  msg.statusCode = statusCode;\n  msg.headers = { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' };\n  msg.payload = { error: message };\n  return [null, msg];\n}\n\nconst fs = global.get('fs');\nif (!fs) return respondError(500, 'Filesystem access is not available in this Node-RED runtime.');\n\nconst sessionsPath = env.get('AUTH_SESSIONS_DB_PATH') || '/var/lib/node-red/auth-sessions.json';\nconst cookieName = env.get('AUTH_COOKIE_NAME') || 'banksiapark_session';\n\nfunction normalizeRole(value) {\n  const normalized = String(value || '').trim().toLowerCase();\n  if (normalized === 'administrator') return 'admin';\n  if (normalized === 'ops') return 'operator';\n  if (normalized === 'view-only') return 'view_only';\n  if (normalized === 'view-only-camera') return 'view_only_camera';\n  return normalized;\n}\n\nfunction getSession(req) {\n  try {\n    const cookies = {};\n    String(req?.headers?.cookie || '').split(';').forEach((entry) => {\n      const index = entry.indexOf('=');\n      if (index < 1) return;\n      cookies[entry.slice(0, index).trim()] = decodeURIComponent(entry.slice(index + 1).trim());\n    });\n    const token = String(cookies[cookieName] || '').trim();\n    if (!token || !fs.existsSync(sessionsPath)) return null;\n    const raw = fs.readFileSync(sessionsPath, 'utf8');\n    const db = raw && raw.trim() ? JSON.parse(raw) : { sessions: {} };\n    const session = db?.sessions?.[token];\n    if (!session) return null;\n    const expiry = Number(session.expiresAt || 0);\n    if (!Number.isFinite(expiry) || expiry <= Date.now()) return null;\n    const roles = Array.isArray(session.roles) ? session.roles.map(normalizeRole) : [];\n    return roles.some((role) => ['admin', 'operator', 'view_only', 'view_only_camera'].includes(role)) ? session : null;\n  } catch (_error) {\n    return null;\n  }\n}\n\nif (!getSession(msg.req)) return respondError(401, 'Authentication required.');\n\nconst ranges = new Set(['1h', '6h', '24h', '7d', '30d']);\nconst requestedRange = String(msg.req?.query?.range || '24h');\nif (!ranges.has(requestedRange)) return respondError(400, 'Unsupported history range.');\n\nconst means = new Set(['1m', '15m', '30m', '1h', '1d', '1w', '1mo']);\nconst requestedMean = String(msg.req?.query?.mean || '1h');\nif (!means.has(requestedMean)) return respondError(400, 'Unsupported averaging interval.');\n\nconst bucket = 'energy_data';\nconst measurement = 'home_power';\nconst field = 'value';\nconst circuitTag = 'device';\n\nfunction fluxString(value) {\n  return `\"${String(value).replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"').replace(/[\\r\\n]/g, '')}\"`;\n}\n\nmsg.query = [\n  `from(bucket: ${fluxString(bucket)})`,\n  `  |> range(start: -${requestedRange})`,\n  `  |> filter(fn: (r) => r[\"_measurement\"] == ${fluxString(measurement)} and r[\"_field\"] == ${fluxString(field)})`,\n  `  |> aggregateWindow(every: ${requestedMean}, fn: mean, createEmpty: false)`,\n  `  |> keep(columns: [\"_time\", \"_value\", ${fluxString(circuitTag)}])`,\n  '  |> sort(columns: [\"_time\"])'\n].join('\\n');\nmsg.powerCircuitTag = circuitTag;\nmsg.powerMean = requestedMean;\nmsg.powerResponseType = 'readings';\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
