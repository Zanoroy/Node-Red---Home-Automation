    {
        "id": "313c597ffce35352",
        "type": "function",
        "z": "67860df720f06663",
        "name": "Format power readings",
        "func": "function respond(statusCode, payload) {\n  msg.statusCode = statusCode;\n  msg.headers = { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' };\n  msg.payload = payload;\n  return msg;\n}\n\nconst circuitTag = String(msg.powerCircuitTag || 'device');\nconst source = msg.payload;\nlet sourceRows = [];\n\nif (Array.isArray(source)) {\n  sourceRows = source;\n} else if (source && Array.isArray(source.data)) {\n  sourceRows = source.data;\n} else if (source !== null && source !== undefined && source !== '') {\n  const text = typeof Buffer !== 'undefined' && Buffer.isBuffer(source) ? source.toString('utf8') : String(source);\n  const rows = [];\n  let row = [];\n  let value = '';\n  let quoted = false;\n  for (let index = 0; index < text.length; index += 1) {\n    const character = text[index];\n    if (quoted) {\n      if (character === '\"' && text[index + 1] === '\"') {\n        value += '\"';\n        index += 1;\n      } else if (character === '\"') {\n        quoted = false;\n      } else {\n        value += character;\n      }\n    } else if (character === '\"') {\n      quoted = true;\n    } else if (character === ',') {\n      row.push(value);\n      value = '';\n    } else if (character === '\\n') {\n      row.push(value.replace(/\\r$/, ''));\n      if (row.some((cell) => cell !== '')) rows.push(row);\n      row = [];\n      value = '';\n    } else {\n      value += character;\n    }\n  }\n  if (value !== '' || row.length) {\n    row.push(value.replace(/\\r$/, ''));\n    if (row.some((cell) => cell !== '')) rows.push(row);\n  }\n\n  const headerIndex = rows.findIndex((csvRow) => csvRow.includes('_time') && csvRow.includes('_value') && csvRow.includes(circuitTag));\n  if (headerIndex >= 0) {\n    const headers = rows[headerIndex];\n    const timeIndex = headers.indexOf('_time');\n    const valueIndex = headers.indexOf('_value');\n    const circuitIndex = headers.indexOf(circuitTag);\n    sourceRows = rows.slice(headerIndex + 1).map((csvRow) => ({\n      _time: csvRow[timeIndex],\n      _value: csvRow[valueIndex],\n      [circuitTag]: csvRow[circuitIndex]\n    }));\n  } else {\n    node.warn('InfluxDB power query response did not contain the configured time, value, and circuit columns.');\n    return respond(502, { error: 'Power data columns did not match the configured InfluxDB schema.' });\n  }\n}\n\nconst readings = [];\nfor (const sourceRow of sourceRows) {\n  if (!sourceRow || typeof sourceRow !== 'object') continue;\n  const time = new Date(sourceRow._time ?? sourceRow.time);\n  const power = Number(sourceRow._value ?? sourceRow.value);\n  const circuit = String(sourceRow[circuitTag] ?? sourceRow.circuit ?? '').trim();\n  if (!Number.isFinite(time.getTime()) || !Number.isFinite(power) || !circuit) continue;\n  readings.push({ time: time.toISOString(), circuit, power });\n}\n\nif (sourceRows.length > 0 && readings.length === 0) {\n  const firstRow = sourceRows[0];\n  const columns = firstRow && typeof firstRow === 'object' ? Object.keys(firstRow).sort().join(', ') : '(not an object)';\n  node.warn(`InfluxDB returned ${sourceRows.length} rows, but none matched _time, _value, and ${circuitTag}. Available columns: ${columns}.`);\n}\n\nreadings.sort((left, right) => left.time.localeCompare(right.time));\nreturn respond(200, { ok: true, generatedAt: new Date().toISOString(), mean: msg.powerMean || '1h', readings });",
