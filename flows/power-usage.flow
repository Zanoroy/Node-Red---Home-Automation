    {
        "id": "0c81e8da4a5cfe40",
        "type": "function",
        "z": "67860df720f06663",
        "name": "Format top circuit energy",
        "func": "function respond(statusCode, payload) {\n  msg.statusCode = statusCode;\n  msg.headers = { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' };\n  msg.payload = payload;\n  return msg;\n}\n\nconst circuitTag = String(msg.powerCircuitTag || 'device');\nconst source = msg.payload;\nconst rows = Array.isArray(source) ? source : (source && Array.isArray(source.data) ? source.data : []);\nif (!Array.isArray(source) && !(source && Array.isArray(source.data))) {\n  node.warn('InfluxDB top usage query returned an unexpected result shape.');\n  return respond(502, { error: 'Top power usage data could not be read from InfluxDB.' });\n}\n\nconst totals = new Map();\nfor (const row of rows) {\n  if (!row || typeof row !== 'object') continue;\n  const circuit = String(row[circuitTag] ?? row.circuit ?? '').trim();\n  const energyWh = Number(row._value ?? row.value);\n  if (!circuit || !Number.isFinite(energyWh)) continue;\n  totals.set(circuit, (totals.get(circuit) || 0) + energyWh / 1000);\n}\n\nif (rows.length > 0 && totals.size === 0) {\n  const columns = rows[0] && typeof rows[0] === 'object' ? Object.keys(rows[0]).sort().join(', ') : '(not an object)';\n  node.warn(`InfluxDB total usage rows did not include ${circuitTag} and _value columns. Available columns: ${columns}.`);\n  return respond(502, { error: 'Top power usage columns did not match the configured InfluxDB schema.' });\n}\n\nconst devices = Array.from(totals, ([circuit, energyKwh]) => ({ circuit, energyKwh }))\n  .sort((left, right) => right.energyKwh - left.energyKwh)\nreturn respond(200, { ok: true, generatedAt: new Date().toISOString(), range: msg.powerRange, devices });",
